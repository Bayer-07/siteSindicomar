# Endereço público
NEXT_PUBLIC_SITE_URL=https://www.sindicomar.com.br
NEXT_PUBLIC_CONTACT_EMAIL=sindicomarmarechal@gmail.com
NEXT_PUBLIC_CONTACT_PHONE=(45) 3284-1277
NEXT_PUBLIC_WHATSAPP_NUMBER=

# PostgreSQL e autenticação própria
DATABASE_URL=postgresql://app_user:senha@127.0.0.1:5432/sindicomar
DATABASE_MIGRATION_URL=postgresql://migration_user:senha@127.0.0.1:5432/sindicomar
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
ADMIN_EMAIL=administrador@exemplo.com
ADMIN_INITIAL_PASSWORD=
AUTH_SESSION_SECRET=
AUTH_ENCRYPTION_KEY=
UPLOADS_DIR=/home/usuario/data/sindicomar/uploads
DB_CONNECTION_LIMIT=5
DB_IDLE_TIMEOUT_MS=60000
DB_CONNECTION_TIMEOUT_MS=10000
DEMO_MODE=false

# PostgreSQL Docker (desenvolvimento ou VPS)
POSTGRES_AUTO_START=true
POSTGRES_CONTAINER=sindicomar-postgres
POSTGRES_DB=sindicomar
POSTGRES_USER=app_user
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_PORT=5432
POSTGRES_DATA_DIR=./.postgres-data
POSTGRES_ADMIN_URL=postgresql://postgres_admin:senha@127.0.0.1:5432/sindicomar
POSTGRES_APP_USER=sindicomar_app
POSTGRES_APP_PASSWORD=troque-esta-senha
POSTGRES_MIGRATION_USER=sindicomar_migration
POSTGRES_MIGRATION_PASSWORD=troque-esta-senha
POSTGRES_BACKUP_DIR=/srv/sindicomar/backups

# Migração única do MySQL para PostgreSQL (não usar no runtime)
MYSQL_SOURCE_URL=mysql://usuario:senha@127.0.0.1:3306/sindicomar
MYSQL_UPLOADS_DIR=./.local-uploads
POSTGRES_DATABASE_URL=postgresql://migration_user:senha@127.0.0.1:5432/sindicomar

# Formulários e e-mail
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=Sindicomar <atendimento@sindicomar.com.br>
FORM_NOTIFICATION_EMAIL=sindicomarmarechal@gmail.com
EMAIL_TRANSPORT=resend
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
